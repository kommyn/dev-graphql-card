generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
    id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    name String
    description String
    links String[]
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

    jobs Job[]
    projects Project[]
    skills SkillsOnProfile[]

    @@map("profiles")
}

model Job {
    id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    name String
    jobTitle String @map("job_title")
    dateStart DateTime @map("date_start") @db.Timestamptz()
    dateEnd DateTime? @map("date_end") @db.Timestamptz()
    achievements String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    profileId String @map("profile_id") @db.Uuid

    profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    skills SkillsOnJobs[]

    @@index([profileId])
    @@map("jobs")
}

model Project {
    id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    name String
    link String?
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    profileId String @map("profile_id") @db.Uuid

    profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

    @@index([profileId])
    @@map("projects")
}

model Skill {
    id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    name String @unique
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

    jobs SkillsOnJobs[]
    profiles SkillsOnProfile[]

    @@map("skills")
}

model SkillsOnJobs {
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
    skillId String @db.Uuid @map("skill_id")
    job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
    jobId String @db.Uuid @map("job_id")

    @@id([skillId, jobId])
    @@index([jobId])
    @@map("skills_on_jobs")
}

model SkillsOnProfile {
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
    skillId String @db.Uuid @map("skill_id")
    profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    profileId String @db.Uuid @map("profile_id")

    @@id([skillId, profileId])
    @@index([profileId])
    @@map("skills_on_profiles")
}
