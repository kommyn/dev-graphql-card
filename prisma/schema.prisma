generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
    id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    name String
    description String
    links String[]
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

    jobs Job[]
    projects Project[]

    @@map("profiles")
}

